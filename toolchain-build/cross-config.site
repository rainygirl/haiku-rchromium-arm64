# Answers for the tests configure cannot run when cross-compiling to Haiku.
ac_cv_file__dev_ptmx=no
ac_cv_file__dev_ptc=no
ac_cv_buggy_getaddrinfo=no
ac_cv_have_long_long_format=yes
ac_cv_working_tzset=yes
ac_cv_little_endian_double=yes
ac_cv_pthread=yes
ac_cv_func_wcsftime=yes
ac_cv_broken_nice=no
ac_cv_broken_poll=no
ac_cv_have_size_t_format=yes

# Haiku ships an os/bluetooth/bluetooth.h, which turns HAVE_BLUETOOTH_H on and
# makes socketmodule.c reach for the NetBSD <netbt/*.h> headers Haiku does not
# have. Haiku's bluetooth stack is not the one socketmodule expects anyway.
ac_cv_header_bluetooth_h=no
ac_cv_header_bluetooth_bluetooth_h=no

# Everything else these modules need -- openssl, sqlite, xz, bzip2, readline --
# is cross-built by build-pydeps-arm64.sh into the same sysroot, so they are
# left enabled. Only _tkinter stays off: there is no tcl/tk for arm64 and no
# reason to want one on this image.
py_cv_module__tkinter=n/a
