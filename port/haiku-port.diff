+# Copyright 2026 The RENKU project
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+declare_args() {
+  # Prefix for the Haiku cross toolchain, when building on a non-Haiku host.
+  # Empty when building natively on Haiku, where the tools are unprefixed.
+  haiku_toolprefix = "aarch64-unknown-haiku-"
+
+  # Root of a Haiku sysroot: the directory holding boot/system/develop.
+  # Empty means build natively against the running system.
+  haiku_sysroot = ""
+}
