diff --git a/build/toolchain/haiku/BUILD.gn b/build/toolchain/haiku/BUILD.gn
new file mode 100644
index 0000000000..17b1cfe6d7
--- /dev/null
+++ b/build/toolchain/haiku/BUILD.gn
@@ -0,0 +1,51 @@
+# Copyright 2026 The RENKU project
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+#
+# Toolchains for building Chromium against Haiku.
+#
+# Both the native case (building on Haiku with the clang from the image) and
+# the cross case (building on Linux with the Haiku cross toolchain) go through
+# clang_toolchain; they differ only in the tool prefix, which
+# //build/config/haiku:haiku_toolprefix supplies.
+
+import("//build/config/haiku/haiku.gni")
+import("//build/toolchain/gcc_toolchain.gni")
+
+clang_toolchain("clang_arm64") {
+  toolchain_args = {
+    current_cpu = "arm64"
+    current_os = "haiku"
+  }
+}
+
+clang_toolchain("clang_x64") {
+  toolchain_args = {
+    current_cpu = "x64"
+    current_os = "haiku"
+  }
+}
+
+# The Haiku cross toolchain is gcc-based; it is the only compiler that can
+# build for Haiku from a Linux host without first bootstrapping clang, so it
+# stays available as a fallback.
+gcc_toolchain("arm64") {
+  toolprefix = haiku_toolprefix
+
+  cc = "${toolprefix}gcc"
+  cxx = "${toolprefix}g++"
+
+  ar = "${toolprefix}ar"
+  ld = cxx
+  readelf = "${toolprefix}readelf"
+  nm = "${toolprefix}nm"
+
+  toolchain_args = {
+    current_cpu = "arm64"
+    current_os = "haiku"
+
+    # Remote execution does not support gcc.
+    use_remoteexec = false
+    is_clang = false
+  }
+}
