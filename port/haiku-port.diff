diff --git a/build/config/haiku/BUILD.gn b/build/config/haiku/BUILD.gn
new file mode 100644
index 0000000000..c157291970
--- /dev/null
+++ b/build/config/haiku/BUILD.gn
@@ -0,0 +1,28 @@
+# Copyright 2026 The RENKU project
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+import("//build/config/haiku/haiku.gni")
+
+# Haiku's headers are not laid out the way any other POSIX system's are:
+# every kit has its own directory, and the gnu and bsd directories wrap the
+# POSIX ones with #include_next, so they must come first. A Haiku-configured
+# compiler already knows all of this through --with-sysroot, so nothing is
+# added here for the native case; only a cross build needs to be told.
+config("sdk") {
+  if (haiku_sysroot != "") {
+    cflags = [ "--sysroot=$haiku_sysroot" ]
+    ldflags = [ "--sysroot=$haiku_sysroot" ]
+  }
+
+  # Haiku hides its BSD and GNU extensions -- memrchr, strchrnul,
+  # pthread_getattr_np -- behind _DEFAULT_SOURCE, and anything that defines
+  # _POSIX_C_SOURCE or _XOPEN_SOURCE turns that off.
+  defines = [ "_DEFAULT_SOURCE" ]
+}
+
+# Haiku's C library is libroot; there is no separate libpthread, librt, libdl
+# or libm to link.
+config("runtime_library") {
+  libs = [ "root" ]
+}
